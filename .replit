run = "npm run dev -- --host 0.0.0.0 --port 5000"
entrypoint = "src/main.tsx"
modules = ["nodejs-20", "web", "python-base-3.13"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
# Production is deployed by Cloudflare Pages from GitHub, not from Replit.
run = ["sh", "-c", "npm run preview -- --host 0.0.0.0 --port ${PORT:-5000}"]
build = ["sh", "-c", "npm run build"]
deploymentTarget = "gce"
ignorePorts = false

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
